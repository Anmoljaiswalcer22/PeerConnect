# Copy to .env for local development (optional; the defaults work out of the box).
# VITE_ variables are embedded in the public browser bundle: never put secrets here.

# Where the Vite dev server forwards /api and /socket.io. Change only if your
# backend runs on another port or machine.
VITE_DEV_API_TARGET=http://localhost:5001

# Socket.IO server URL.
#  - Local development: leave EMPTY (Vite proxies /socket.io to the backend).
#  - Vercel: set to your Render URL, e.g. https://peerconnect-api.onrender.com
#    (Vercel can't proxy WebSockets, so the browser connects to Render directly.)
VITE_SOCKET_URL=
