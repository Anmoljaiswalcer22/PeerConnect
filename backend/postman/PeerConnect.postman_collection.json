{
  "info": {
    "name": "PeerConnect API",
    "description": "Manual API tests for PeerConnect.\n\n1. Run the backend with `npm run dev` (nodemon).\n2. Run **Auth → Sign up** (or **Log in**). Postman stores the session cookie automatically.\n3. Run **Messages → Contacts**: the first contact's id is saved to `peerId`.\n4. Run the other requests.\n\nTo test production, change `baseUrl` to your Render URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "email", "value": "asha@example.com" },
    { "key": "password", "value": "secret123" },
    { "key": "peerId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('database connected', () => pm.expect(pm.response.json().data.database).to.eql('connected'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Asha Verma\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created (or 409 if you already signed up: use Log in)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) pm.test('no password in response', () => pm.expect(pm.response.json().data.user.password).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Check session",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/check" },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('logged in', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Update name",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/update-profile",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Asha V.\"\n}" }
          }
        },
        {
          "name": "Wrong password → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password1\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Log out",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Contacts",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/messages/users" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const users = pm.response.json().data.users;",
                  "if (users.length) pm.collectionVariables.set('peerId', users[0]._id);",
                  "else console.log('No other users yet: sign up a second account to message.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/messages/send/{{peerId}}",
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Hello from Postman!\",\n  \"clientMessageId\": \"{{$guid}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "Conversation history",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/messages/{{peerId}}?limit=30" }
        },
        {
          "name": "Empty message → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/messages/send/{{peerId}}",
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"   \",\n  \"clientMessageId\": \"{{$guid}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"] }
            }
          ]
        }
      ]
    }
  ]
}
