# Copy this file to .env and fill in the values.  NEVER commit .env.

# development | production | test   (nodemon sets development automatically)
NODE_ENV=development

# Local port. Render sets PORT itself in production, so don't add it there.
PORT=5001

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Atlas → Connect → Drivers. Replace <db_password> with your database user's password.
# If the password contains @ : / ? # [ ] %, URL-encode it (e.g. @ → %40).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=PeerConnect
MONGODB_DB_NAME=peerconnect

# ── Authentication ────────────────────────────────────────────────────────────
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production. Changing it logs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API and open sockets.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
CLIENT_URLS=http://localhost:5173

# Number of proxies in front of the server. Local: 1. Render behind Vercel: 2.
TRUST_PROXY=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Cloudinary (optional: profile pictures & attachments) ────────────────────
# Cloudinary Dashboard → "API Keys". Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
